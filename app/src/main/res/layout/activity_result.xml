<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/textJudul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hasil Quiz Vocabulary"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#212121"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/progressRing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>

    <com.learntospell.myapplication.ProgressRingView
    android:id="@+id/progressRing"
    android:layout_width="220dp"
    android:layout_height="220dp"
    android:layout_marginTop="25dp"
    app:layout_constraintTop_toBottomOf="@id/textJudul"
    app:layout_constraintBottom_toTopOf="@+id/textPredikat"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textPredikat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Excellent!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#20A36B"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/progressRing"
        app:layout_constraintBottom_toTopOf="@+id/textTotal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kamu telah menyelesaikan 10 soal"
        android:textSize="14sp"
        android:textColor="#777777"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textPredikat"
        app:layout_constraintBottom_toTopOf="@+id/boxBenar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/boxBenar"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#E8F5E9"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintTop_toBottomOf="@+id/textTotal"
        app:layout_constraintBottom_toTopOf="@+id/boxMainLagi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/boxSalah">

        <TextView
            android:id="@+id/textBenar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#20A36B"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jawaban Benar"
            android:textColor="#333333"/>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/boxSalah"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FFEBEE"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toTopOf="@id/boxBenar"
        app:layout_constraintBottom_toBottomOf="@+id/boxBenar"
        app:layout_constraintStart_toEndOf="@+id/boxBenar"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textSalah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jawaban Salah"
            android:textColor="#333333"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnMainLagi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Main Lagi"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toButtonof="@id/boxBenar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />





</androidx.constraintlayout.widget.ConstraintLayout>